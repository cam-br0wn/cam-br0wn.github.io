// cambrown.io: static personal site served as Cloudflare Worker assets.
// Deploy: npx wrangler deploy   (from this folder)
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cambrown-io",
  "compatibility_date": "2026-10-01",
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "./docs",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  },
  "routes": [
    { "pattern": "cambrown.io", "custom_domain": true },
    { "pattern": "www.cambrown.io", "custom_domain": true }
  ]
}
